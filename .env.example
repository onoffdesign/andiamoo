# Copia questo file come ".env" (stessa cartella) e compila. Il file .env non va mai su GitHub.

# Email di contatto: va nello user agent del bot di raccolta e nelle richieste a OpenStreetMap
CONTACT_EMAIL=info@onoff.zone

# Bot Telegram: crealo con @BotFather e incolla qui il token
TELEGRAM_TOKEN=
# Il tuo id Telegram (scrivi a @userinfobot per saperlo): solo tu approvi le segnalazioni
TELEGRAM_ADMIN_CHAT_ID=

# Modulo organizzatori: Google Form -> Fogli -> File > Condividi > Pubblica sul web > CSV
FORM_CSV_URL=
